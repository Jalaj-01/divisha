# ==============================================================================
# DIVISHA ELECTRONICS — PLATFORM CONFIGURATION
# ==============================================================================

# Application Ports
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
NODE_ENV=development

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# In production, provide the Supabase PostgreSQL connection string with pgbouncer.
# When left empty in local dev, the platform seamlessly uses embedded/in-memory storage.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/divisha_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/divisha_db?schema=public"

# Supabase Auth & Storage (Optional for initial local dev)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# REDIS & QUEUES (Caching, Rate Limiting, BullMQ)
# ------------------------------------------------------------------------------
# When left empty, the platform falls back to high-performance InMemoryCache & InMemoryQueue
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# JWT & SECURITY SECRETS
# ------------------------------------------------------------------------------
JWT_SECRET="divisha-production-grade-super-secure-jwt-secret-key-2026"
JWT_EXPIRES_IN="7d"
ADMIN_SESSION_SECRET="divisha-admin-portal-session-encryption-key-2026"

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Supports test/mock mode with cryptographic webhook validation
RAZORPAY_KEY_ID="rzp_test_divisha_mock_key"
RAZORPAY_KEY_SECRET="divisha_mock_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="divisha_mock_webhook_secret"

# ------------------------------------------------------------------------------
# WHATSAPP BUSINESS TOOLS
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="divisha_whatsapp_verify_token"
WHATSAPP_BUSINESS_PHONE="+919876543210" # Customer-facing WhatsApp Concierge number
